
# Postgres connection URL (example); the database needs the pgvector extension for Ask AI
DATABASE_URL=postgres://postgres:postgres@localhost:5432/malanghub?sslmode=disable
PORT=8080


# Authentication
# A long, random string (at least 32 bytes, e.g. `openssl rand -hex 32`).
# Required: the server refuses to start without it. Keep secret in production.
JWT_SECRET=changeme
# Optional: JWT token TTL (example: 24h, 7d)
JWT_EXPIRES_IN=24h

# Google OAuth (optional)
# If you enable Google Sign-In, set these to your OAuth client credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Google sign-in only accepts tokens issued to these client IDs (all of the
# GOOGLE_*CLIENT_ID vars count). List extra ones, e.g. the native desktop
# client, comma-separated in GOOGLE_ALLOWED_CLIENT_IDS.
GOOGLE_ALLOWED_CLIENT_IDS=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_SERVER_CLIENT_ID=

# Redis (optional) — used for caching DB query results
# Full URL takes precedence; defaults to redis://localhost:6379 when unset
REDIS_URL=redis://localhost:6379

# New Relic (optional)
# Set NEW_RELIC_ENABLED=false to disable even if keys exist
NEW_RELIC_ENABLED=true
NEW_RELIC_APP_NAME=MyApp
NEW_RELIC_LICENSE_KEY=
# Set to true to enable debug logging from the agent
NEW_RELIC_DEBUG=false

# Misc
# GIN_MODE can be "debug", "release", or "test"
GIN_MODE=debug

# Cloudinary (optional)
# Provide either `CLOUDINARY_URL` or the individual pieces below.
# Example URL: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# IndexNow — generate with: uuidgen | tr -d '-' | tr '[:upper:]' '[:lower:]'
# Must match the INDEXNOW_KEY in the frontend .env
INDEXNOW_KEY=
SITE_URL=https://www.malanghub.com

# Ask AI (optional) — free-tier LLM providers, tried in order (failover).
# Without any key, /api/ai/ask returns related articles only.
AI_PROVIDERS=gemini,groq
# Google AI Studio key (free tier). Also used for embeddings (vector search).
GEMINI_API_KEY=
# Model IDs get retired; if logs show "model not found", pick a current one
# from https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
# Must match the Atlas vector index; changing it requires dropping
# newsEmbeddings + the news_embedding_idx search index and reindexing.
GEMINI_EMBED_DIM=768
# Groq key (free tier), used when Gemini is unavailable or out of quota.
GROQ_API_KEY=
# Current models: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
# Per-IP questions per hour, and total LLM calls per day (0 disables a limit)
AI_RATE_LIMIT_PER_HOUR=10
AI_DAILY_LIMIT=800
# Langfuse v4 tracing over OpenTelemetry for every Gemini/Groq call; tracing is off when the keys are empty.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Legacy name, used only when LANGFUSE_BASE_URL is empty.
LANGFUSE_HOST=
# Optional Langfuse environment (lowercase, e.g. production).
LANGFUSE_TRACING_ENVIRONMENT=
# How often embeddings are re-synced in the background (0 disables)
AI_SYNC_INTERVAL=6h

# Put iOS 1.0.2 and macOS 1.0.2 into review
APP_STORE_REVIEW=ios:1.0.2,macos:1.0.2

# Put ALL iOS versions into review (any version)
# APP_STORE_REVIEW=ios

# Not in review (default)
# APP_STORE_REVIEW=

# Apple sign-in: comma-separated bundle IDs / Services IDs accepted as the
# identity token audience. Apple sign-in is rejected while this is empty.
APPLE_CLIENT_IDS=

# Client IP for rate limits. By default the TCP peer address is used and
# X-Forwarded-For is ignored. Behind a proxy, list its IPs/CIDRs
# (comma-separated) so the client IP is read from X-Forwarded-For.
TRUSTED_PROXIES=
# Or name a header the platform edge always overwrites with the client IP
# (e.g. CF-Connecting-IP), only if the backend can't be reached around it.
TRUSTED_PLATFORM_HEADER=
# Per-IP signin and signup attempts per hour (default 30, 0 disables)
AUTH_RATE_LIMIT_PER_HOUR=
