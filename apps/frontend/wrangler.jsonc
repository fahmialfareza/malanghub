{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "malanghub",
  // worker.ts wraps .open-next/worker.js with an edge cache for article pages.
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Runtime vars are managed in the Cloudflare dashboard; don't wipe them on deploy.
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "malanghub"
    }
  ],
  // Deployment id, used to key the edge cache per deploy (see worker.ts).
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "observability": {
    "enabled": true
  }
}
