{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // Cloudflare Pages config. It lives in its own folder because
  // `wrangler pages deploy` only reads the wrangler config in the current
  // directory, and ../wrangler.jsonc is the Workers config. The package.json
  // next to this file marks the project root so wrangler doesn't also pick up
  // the parent Workers config.
  // Build with `pnpm pages:build`, deploy with `pnpm pages:deploy`.
  "name": "malanghub",
  "pages_build_output_dir": "./dist",
  // Keep in sync with ../wrangler.jsonc.
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"]
  // No WORKER_SELF_REFERENCE: OpenNext only uses it for on-demand ISR
  // revalidation, which this app does not use (getServerSideProps only).
  // With a config file, this file owns plain-text vars, so keep the
  // runtime values (API_ADDRESS, INDEXNOW_KEY, SENTRY_DSN) as Pages secrets:
  // `wrangler pages secret put <NAME> --project-name malanghub`.
  // NEXT_PUBLIC_* values are inlined at build time, not read here.
}
