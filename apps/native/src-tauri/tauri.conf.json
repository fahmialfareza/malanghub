{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Malanghub",
  "version": "0.1.0",
  "identifier": "com.malanghub.native",
  "build": {
    "beforeDevCommand": "pnpm mobile:config && pnpm dev --host 0.0.0.0",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm mobile:prepare && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Malanghub",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 640,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' https://*.fontawesome.com https://cdn.tiny.cloud",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com https://*.fontawesome.com https://cdn.tiny.cloud",
        "font-src": "'self' data: https://fonts.gstatic.com https://*.fontawesome.com https://cdn.tiny.cloud",
        "img-src": "'self' data: blob: https:",
        "media-src": "'self' blob: https:",
        "connect-src": "'self' ipc: http://ipc.localhost https:",
        "frame-src": "https://www.youtube.com https://youtube.com https://www.youtube-nocookie.com https://youtube-nocookie.com https://www.google.com",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Malanghub Team",
    "category": "News",
    "homepage": "https://malanghub.com",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "macOS": {
      "entitlements": "./Entitlements.plist"
    }
  },
  "plugins": {
    "shell": {
      "open": "((mailto:.+)|(tel:.+)|(sms:.+)|(https?://.+)|(intent:.+)|(geo:.+)|(maps:.+)|(whatsapp:.+)|(comgooglemaps:.+)|(google\\.navigation:.+))"
    },
    "deep-link": {
      "mobile": [
        {
          "scheme": ["com.malanghub.native"],
          "appLink": false
        }
      ],
      "desktop": {
        "schemes": ["com.malanghub.native"]
      }
    }
  }
}
